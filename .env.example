# =====================================================================
# ETTJ 环境变量模板
# 复制成 .env 后填真实值；.env 已被 .gitignore 忽略，不会进仓库
#   copy .env.example .env
# =====================================================================

# ---------- 运行环境 ----------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---------- 模型（火山方舟，兼容 OpenAI 协议）----------
VOLCENGINE_API_KEY='<你的方舟 API Key>'
# 只写到 /api/v3，不要再带 /chat/completions（SDK 会自己拼）
VOLCENGINE_BASE_URL='https://ark.cn-beijing.volces.com/api/v3'
# 方舟真实 Model ID 带版本号，可在 GET /api/v3/models 查
MODEL=doubao-seed-2-1-lite-260915
TEMPERATURE=0
MAX_TOKENS=4096
THINKING=disabled

# ---------- MySQL（建议用只授 SELECT 的账号）----------
# 只填字段值，不要写连接串；真实地址与密码只存在于本地 .env
MYSQL_HOST=<数据库地址>
MYSQL_PORT=3306
MYSQL_USER=<只读账号>
MYSQL_PASSWORD=<密码>
MYSQL_DB=procurement
MYSQL_POOL_SIZE=5
MYSQL_CONNECT_TIMEOUT=10

# ---------- SQL 只读与体积控制 ----------
SQL_READ_ONLY=true
SQL_MAX_ROWS=50
SQL_MAX_CHARS=6000
SQL_SAMPLE_ROWS=3
SQL_STATEMENT_TIMEOUT_MS=15000

# ---------- 本地存储 ----------
DATA_DIR=./data
CHECKPOINT_DB=./data/checkpoints.sqlite

# ---------- LangSmith 可观测性（可选）----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ETTJ
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
